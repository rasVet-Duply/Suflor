<Window x:Class="SchoolDesk.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" Title="SchoolDesk">
    <StackPanel Margin="24">
        <TextBlock x:Name="Head" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="Введите пароль администратора" Margin="0,0,0,6"/>
        <PasswordBox x:Name="Pwd" FontSize="16" Padding="6"/>
        <TextBlock x:Name="Err" Foreground="#C62828" Margin="0,8,0,0" TextWrapping="Wrap" MinHeight="20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Отмена" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="OK" IsDefault="True" Padding="24,6" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
