<UserControl x:Class="SchoolDesk.StringListEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="4">
        <TextBlock x:Name="HeaderText" DockPanel.Dock="Top" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,6"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" Content="Удалить" Click="Remove_Click"/>
            <Button DockPanel.Dock="Right" Content="Добавить" Click="Add_Click"/>
            <TextBox x:Name="Input" KeyDown="Input_KeyDown"/>
        </DockPanel>
        <ListBox x:Name="List"/>
    </DockPanel>
</UserControl>
