<Window x:Class="SchoolDesk.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="440" SizeToContent="Height" WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize" Topmost="True" Title="SchoolDesk — первичная настройка">
    <StackPanel Margin="24">
        <TextBlock Text="Первичная настройка" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <TextBlock Text="Название школы"/>
        <TextBox x:Name="SchoolBox" Padding="4" Margin="0,2,0,8"/>
        <TextBlock Text="Название компьютера"/>
        <TextBox x:Name="PcBox" Padding="4" Margin="0,2,0,8"/>
        <TextBlock Text="Пароль администратора (не короче 6 символов)"/>
        <PasswordBox x:Name="P1" Padding="4" Margin="0,2,0,8"/>
        <TextBlock Text="Повторите пароль"/>
        <PasswordBox x:Name="P2" Padding="4" Margin="0,2,0,8"/>
        <TextBlock x:Name="Err" Foreground="#C62828" TextWrapping="Wrap" MinHeight="20"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Отмена" IsCancel="True" Padding="16,6" Margin="0,0,8,0"/>
            <Button Content="Сохранить" IsDefault="True" Padding="20,6" Click="Ok_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
